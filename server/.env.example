# Copy this file to ".env" and fill in the values.

# Port the API listens on
PORT=5000

# Allowed frontend origin(s) during development (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# ---- Contact form email (optional) ----
# If these are left empty, messages are saved to server/data/messages.json instead of emailed.
# For Gmail, create an App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where contact-form messages should be delivered
CONTACT_TO=kdguinto@fit.edu.ph.com
